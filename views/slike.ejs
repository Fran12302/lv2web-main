<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galerija filmova</title>

    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/style_slike.css">
</head>
<body>

<header>
    <h1>Moja web stranica o filmovima</h1>
</header>

<nav>
    <ul class="nav-menu">
        <li><a href="/">Početna</a></li>
        <li><a href="/grafikon">Grafikoni</a></li>
        <li><a href="/slike">Galerija</a></li>
    </ul>
</nav>

<main class="content">
    <section class="galerija">
        <h2>Galerija filmskih slika</h2>

        <div class="img-gallery-magnific">

            <% const slike = [
                {url: "https://images.unsplash.com/photo-1489599849927-2ee91cede3ba", title: "Kino dvorana"},
                {url: "https://images.unsplash.com/photo-1440404653325-ab127d49abc1", title: "Filmska kamera"},
                {url: "https://images.unsplash.com/photo-1513106580091-1d82408b8cd6", title: "Kino izvana"},
                {url: "https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c", title: "Projekcija"}
            ]; %>

            <% slike.forEach(slika => { %>
                <figure class="magnific-img galerija_slika">
                    <img src="<%= slika.url %>?w=500" alt="<%= slika.title %>">
                    <figcaption><%= slika.title %></figcaption>
                </figure>
            <% }) %>

        </div>
    </section>
</main>

<footer>
    <p>&copy; 2025 Web programiranje</p>
</footer>

</body>
</html>